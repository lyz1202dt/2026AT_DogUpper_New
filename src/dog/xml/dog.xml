        <actuatorpos name="LF_thigh_p" actuator="LF_thigh" />
        <actuatorpos name="LF_calf_p" actuator="LF_calf" />

        <actuatorpos name="RF_hip_p" actuator="RF_hip" />
        <actuatorpos name="RF_thigh_p" actuator="RF_thigh" />
