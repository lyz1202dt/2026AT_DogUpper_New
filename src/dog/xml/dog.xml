        <motor name="RB_thigh" joint="rb_joint2" gear="1" ctrllimited="true" ctrlrange="-12 12" />
        <motor name="RB_calf" joint="rb_joint3" gear="1" ctrllimited="true" ctrlrange="-12 12" />
    </actuator>
    <sensor>
