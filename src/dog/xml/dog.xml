    <actuator>
        <!-- Left Front -->
        <motor name="LF_hip" joint="lf_joint1" gear="1" ctrllimited="true" ctrlrange="-12 12" />
        <motor name="LF_thigh" joint="lf_joint2" gear="1" ctrllimited="true" ctrlrange="-12 12" />
        <motor name="LF_calf" joint="lf_joint3" gear="1" ctrllimited="true" ctrlrange="-12 12" />

        <!-- Right Front -->
        <motor name="RF_hip" joint="rf_joint1" gear="1" ctrllimited="true" ctrlrange="-12 12" />
        <motor name="RF_thigh" joint="rf_joint2" gear="1" ctrllimited="true" ctrlrange="-12 12" />
        <motor name="RF_calf" joint="rf_joint3" gear="1" ctrllimited="true" ctrlrange="-12 12" />

        <!-- Left Back -->
        <motor name="LB_hip" joint="lb_joint1" gear="1" ctrllimited="true" ctrlrange="-12 12" />
        <motor name="LB_thigh" joint="lb_joint2" gear="1" ctrllimited="true" ctrlrange="-12 12" />
        <motor name="LB_calf" joint="lb_joint3" gear="1" ctrllimited="true" ctrlrange="-12 12" />

        <!-- Right Back -->
