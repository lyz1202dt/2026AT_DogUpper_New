<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="sw_scene">
    <!-- STEP 场景模型（局部物体） -->
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="scene_link">
      <!-- 碰撞 -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>scene2.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <!-- 视觉 -->
      <visual name="visual">
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
        <geometry>
          <mesh>
            <uri>scene2.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
